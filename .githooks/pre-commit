#!/usr/bin/env bash
# Mirrors CI: formatting, vet and tests must pass before a commit.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail
unformatted=$(gofmt -l .)
if [[ -n $unformatted ]]; then echo "gofmt needed:"; echo "$unformatted"; exit 1; fi
go vet ./...
go test -race -count=3 ./...
